<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>For Kalyani 💗</title>
<style>
:root{--pink:#f45b98;--deep:#9b285b;--paper:#fffafc;--ink:#71324f}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:Georgia,"Times New Roman",serif;color:var(--ink);background:radial-gradient(circle at top,#fff6fb,#ffd5e6 65%,#f7b5d1);overflow-x:hidden}
main{min-height:100vh;display:grid;place-items:center;padding:28px 14px;position:relative;isolation:isolate}
.glow{position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 20% 20%,#fff9 0 2px,transparent 3px),radial-gradient(circle at 80% 35%,#fff9 0 2px,transparent 3px);background-size:90px 100px;animation:twinkle 4s ease-in-out infinite alternate;z-index:-1}
.card{width:min(100%,560px);padding:clamp(24px,6vw,46px) clamp(18px,5vw,38px);border:1px solid #ffffffc9;border-radius:30px;background:#fffafcf0;box-shadow:0 22px 70px #a72d5b22;text-align:center;position:relative;overflow:hidden}
.kicker{letter-spacing:.14em;text-transform:uppercase;font:12px Arial,sans-serif;color:#b65b80}
h1{font-size:clamp(2.2rem,9vw,3.6rem);line-height:1.08;color:var(--deep);margin:12px 0}
p{font-size:clamp(1.05rem,4vw,1.28rem);line-height:1.7}
.emoji{font-size:56px;display:inline-block;animation:heartbeat 1.8s infinite}
button{border:0;border-radius:999px;padding:15px 23px;margin:8px 4px;background:var(--pink);color:white;font:600 16px Arial,sans-serif;box-shadow:0 10px 25px #e74f8d35;cursor:pointer;transition:transform .2s,filter .2s}
button:hover{transform:translateY(-2px);filter:brightness(1.04)}
button:focus-visible{outline:3px solid #8c2852;outline-offset:3px}
.secondary{background:#fff;color:var(--deep);border:1px solid #f2b7ce;box-shadow:none}
#letter{display:none;margin:24px 0 0;padding:22px 18px;border-radius:22px;background:#fff0f6;text-align:left;animation:rise .8s both}
#letter h2,#proposal h2{text-align:center;color:var(--deep);font-size:clamp(1.5rem,6vw,2rem)}
.note{white-space:pre-line}
#proposal{display:none;margin-top:24px;padding-top:12px;border-top:1px dashed #e9a8c3;animation:rise .8s both}
.choice{display:flex;justify-content:center;flex-wrap:wrap;gap:8px}
#reply{min-height:30px;text-align:center;font:15px Arial,sans-serif;color:var(--deep)}
.envelope-wrap{height:180px;display:grid;place-items:center;perspective:800px;margin:8px 0 18px}
.envelope{width:190px;height:125px;position:relative;border:0;border-radius:7px;background:#f6a9c8;box-shadow:0 16px 25px #9b285b25;cursor:pointer;overflow:visible}
.envelope:before{content:"";position:absolute;inset:0;background:#ffd7e6;clip-path:polygon(0 0,50% 58%,100% 0);transform-origin:top;transition:transform .8s;z-index:3}
.envelope:after{content:"";position:absolute;inset:0;background:#f28bb5;clip-path:polygon(0 100%,0 0,50% 58%,100% 0,100% 100%);z-index:2}
.seal{position:absolute;z-index:4;top:45px;left:calc(50% - 19px);font-size:38px;transition:opacity .3s,transform .5s}
.letter-paper{position:absolute;z-index:1;left:10px;right:10px;top:9px;height:105px;background:#fffafc;border-radius:5px;display:grid;place-items:center;font-size:28px;transition:transform .8s}
.envelope.open:before{transform:rotateX(180deg);z-index:0}
.envelope.open .letter-paper{transform:translateY(-65px)}
.envelope.open .seal{opacity:0;transform:scale(.4)}
.hint{font:14px Arial,sans-serif;color:#a35475}
.floaty{position:fixed;bottom:-40px;z-index:-1;pointer-events:none;animation:floatUp linear forwards;opacity:.8}
.petal{position:fixed;top:-30px;z-index:5;pointer-events:none;animation:petalFall linear forwards}
footer{font:13px Arial,sans-serif;color:#b07891;margin-top:25px}
@keyframes heartbeat{0%,100%{transform:scale(1)}12%{transform:scale(1.12)}24%{transform:scale(1)}}
@keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes floatUp{to{transform:translateY(-115vh) rotate(25deg);opacity:0}}
@keyframes petalFall{to{transform:translate3d(70px,110vh,0) rotate(650deg);opacity:.15}}
@keyframes twinkle{from{opacity:.35}to{opacity:1}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<div class="glow" aria-hidden="true"></div>
<main>
<section class="card" aria-labelledby="title">
<div class="kicker">a tiny little surprise</div>
<div class="emoji" aria-hidden="true">💌</div>
<h1 id="title">Hey, Kalyani 💗</h1>
<p>I’m a little shy about saying this out loud… so I made you a tiny surprise.</p>
<div class="envelope-wrap">
<button class="envelope" id="envelope" aria-label="Open the magical envelope" aria-expanded="false">
<span class="letter-paper" aria-hidden="true">💌</span><span class="seal" aria-hidden="true">💖</span>
</button>
</div>
<div class="hint">Tap the envelope to open your little letter ✨</div>
<button id="openLetter">Open my letter 💗</button>

<section id="letter" aria-live="polite">
<h2>A Little Note for You 🌷</h2>
<div class="note">If I could give you one thing in this world, it would be the chance to see yourself through my eyes. ✨

Then you would understand how special you are, how beautiful your smile is, and how even the smallest things about you can make an ordinary day feel brighter.

I don’t need a perfect moment to appreciate you. Sometimes, just seeing you smile is enough to make an ordinary day feel special.

So keep smiling, keep chasing your dreams, and always remember that you deserve happiness, kindness, and all the beautiful things life has to offer.

And if this little website made you smile even for a second, then it has already done what I hoped it would. 🥹❤️</div>
<p style="text-align:center">🌸 💗 🌹 💗 🌸</p>
<button id="showProposal">One tiny question… 👉👈</button>
</section>

<section id="proposal" aria-live="polite">
<h2>Can I tell you something, Kalyani? 🌷</h2>
<p>I think you’re really special, and I’ve started to like you as more than a friend. I wanted to be honest with you and ask…</p>
<p><strong>Would you be open to going on a little date with me sometime? 💗</strong></p>
<p style="font-size:1rem">There’s no pressure at all. It’s completely okay if you don’t feel the same—I’ll respect your answer, and I hope we can still be kind to each other.</p>
<div class="choice">
<button id="yes">I’d like that 😊</button>
<button class="secondary" id="think">I need time 🌼</button>
<button class="secondary" id="no">I don’t feel the same</button>
</div>
<div id="reply" role="status"></div>
</section>
<footer>made with a little courage & lots of kindness ♡</footer>
</section>
</main>
<script>
const envelope=document.getElementById('envelope');
const letter=document.getElementById('letter');
function openLetter(){
  envelope.classList.add('open');
  envelope.setAttribute('aria-expanded','true');
  letter.style.display='block';
  document.getElementById('openLetter').style.display='none';
  setTimeout(()=>letter.scrollIntoView({behavior:'smooth',block:'nearest'}),150);
}
envelope.addEventListener('click',openLetter);
document.getElementById('openLetter').addEventListener('click',openLetter);
document.getElementById('showProposal').addEventListener('click',()=>{
  document.getElementById('proposal').style.display='block';
  document.getElementById('proposal').scrollIntoView({behavior:'smooth',block:'nearest'});
});
document.getElementById('yes').addEventListener('click',()=>document.getElementById('reply').textContent='That makes me really happy 😊 We can figure out something simple together—only whenever you feel comfortable. 💗');
document.getElementById('think').addEventListener('click',()=>document.getElementById('reply').textContent='Of course. Take all the time you need—there’s absolutely no rush. 🌼');
document.getElementById('no').addEventListener('click',()=>document.getElementById('reply').textContent='Thank you for being honest with me. I respect how you feel, and there’s no hard feeling. 💛');
const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduceMotion){
  const symbols=['♡','💗','💕','♥'];
  setInterval(()=>{
    const el=document.createElement('span');el.className='floaty';el.textContent=symbols[Math.floor(Math.random()*symbols.length)];
    el.style.left=Math.random()*100+'vw';el.style.fontSize=(16+Math.random()*20)+'px';el.style.animationDuration=(7+Math.random()*6)+'s';
    document.body.appendChild(el);setTimeout(()=>el.remove(),14000);
  },850);
  setInterval(()=>{
    const el=document.createElement('span');el.className='petal';el.textContent=['🌹','🌸','🌷'][Math.floor(Math.random()*3)];
    el.style.left=Math.random()*100+'vw';el.style.fontSize=(14+Math.random()*13)+'px';el.style.animationDuration=(7+Math.random()*6)+'s';
    document.body.appendChild(el);setTimeout(()=>el.remove(),14000);
  },1100);
}
</script>
</body>
</html>
